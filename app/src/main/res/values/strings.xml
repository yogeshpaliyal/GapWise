    <string name="intro1_title">Remember the\nlast time</string>
    <string name="intro1_body">Haircuts, oil changes, calling your parents. GapWise keeps track of when you last did the things you do now and then.</string>
    <string name="intro2_title">One tap\nlogs it</string>
    <string name="intro2_body">Did it today? Tap the card. That\'s it. You can fix the date or add a note any time.</string>
    <string name="intro3_title">Know what\'s\ndue next</string>
    <string name="intro3_body">After a few logs GapWise learns your usual gap, and the shape tells you when it\'s about time. No streaks, no guilt.</string>
    <string name="intro4_title">Yours,\nand only yours</string>
    <string name="intro4_body">No account and no ads. Everything stays on your phone, with an optional backup to your own Google Drive.</string>
